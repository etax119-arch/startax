# ============================================================================
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워 넣으세요.
# 배포 시에는 Vercel 프로젝트 설정 > Environment Variables 에
# Production / Preview / Development 모두에 동일하게 등록해야 합니다.
# ============================================================================

# ── 이메일 (기존) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=etax119@hanmail.net

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 확인
# 브라우저에 노출되는 값 (RLS로 발행된 글 읽기만 가능)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 절대 브라우저에 노출되면 안 되는 값. RLS를 우회합니다.
# 서버 사이드(app/api/admin/*)에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자 ──────────────────────────────────────────────────────────────────
# Footer > 관리자 버튼으로 진입할 때 입력하는 비밀번호
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명용 시크릿. 아래 명령으로 생성하세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
